# GLPI Agent - collects this machine's inventory and posts it to a GLPI
# server, which creates or updates the matching asset.
#
# nixpkgs HAS the package (pkgs.glpi-agent, 1.20) but NO services.glpi-agent
# module - only services.fusionInventory, which drives the agent's abandoned
# predecessor. So the unit below is hand-written.
#
# Importable unchanged on other NixOS machines: set services.glpi-agent.server
# to the GLPI URL and caCertFile to a copy of the server's certificate. On the
# server itself both default to the local values.
{ config, lib, pkgs, ... }:

let
  cfg = config.services.glpi-agent;

  # The agent REQUIRES a config file to exist and dies without one:
  #
  #   Execution failure:.
  #   Config: non-existing file /etc/agent.cfg
  #
  # With no --conf-file it falls back to `confdir/agent.cfg` (Config.pm:231),
  # and nixpkgs builds it with SYSCONFDIR=/etc, so it demands /etc/agent.cfg -
  # a file no NixOS system has. Passing every setting on the command line is
  # NOT enough; the file check happens first.
  #
  # So generate one. This is also the agent's native idiom (same `key = value`
  # format documented for non-NixOS clients), which keeps the two consistent.
  # Nothing here is secret - a server URL and a path to a public certificate -
  # so the world-readable store is the right place for it.
  configFile = pkgs.writeText "glpi-agent.cfg" (
    lib.concatStringsSep "\n" (
      [
        "# Generated by services.glpi-agent - do not edit."
        "server = ${cfg.server}"
      ]
      ++ lib.optional (cfg.caCertFile != null) "ca-cert-file = ${cfg.caCertFile}"
      ++ lib.optional (cfg.tag != null) "tag = ${cfg.tag}"
      # One key, comma-separated: Config.pm:340 lists no-category among the
      # multi-value options and splits it on /,+/.
      ++ lib.optional (cfg.noCategories != [ ]) (
        "no-category = ${lib.concatStringsSep "," cfg.noCategories}"
      )
      ++ [ "" ]
    )
  );
in
{
  options.services.glpi-agent = {
    enable = lib.mkEnableOption "GLPI inventory agent";

    package = lib.mkOption {
      type = lib.types.package;
      default = pkgs.glpi-agent;
      defaultText = lib.literalExpression "pkgs.glpi-agent";
      description = "The glpi-agent package to run.";
    };

    server = lib.mkOption {
      type = lib.types.str;
      example = "https://nixos.local/";
      description = ''
        Base URL of the GLPI server. The agent appends its own path, so this
        is the site root and NOT /Inventory or /front/inventory.php.
      '';
    };

    caCertFile = lib.mkOption {
      type = lib.types.nullOr lib.types.path;
      default = null;
      example = "/var/lib/glpi-tls/cert.pem";
      description = ''
        Certificate to trust as the anchor for the server's TLS. For a
        self-signed server certificate, this is that same certificate.

        Setting this is strongly preferred over --no-ssl-check: the agent then
        verifies the server properly, so a self-signed setup gets both
        encryption AND authentication. --no-ssl-check would accept any
        certificate at all, which gives encryption against a passive listener
        and no protection whatever against an active one.

        null means use the system trust store, which is correct only when the
        server has a certificate from a CA the machine already trusts.
      '';
    };

    tag = lib.mkOption {
      type = lib.types.nullOr lib.types.str;
      default = null;
      example = "home";
      description = "Optional tag recorded with the inventory, for grouping assets.";
    };

    noCategories = lib.mkOption {
      type = lib.types.listOf lib.types.str;
      default = [
        "environment"
        "process"
      ];
      example = [ ];
      description = ''
        Inventory categories NOT to collect, passed as --no-category.
        Valid names come from `glpi-agent --list-categories`.

        The two defaults are excluded because they are the most sensitive
        things the agent collects and among the least useful for tracking
        assets. On a plain non-root run of this machine the agent gathered:

          environment - 93 environment VARIABLES, names AND VALUES. Env is a
                        routine place for API tokens and credentials, and
                        whatever the agent inherits is posted to the server
                        and stored in its database.
          process     - 247 running processes, including command lines. A
                        process snapshot of every client, kept server-side.

        Neither tells you anything about the hardware or software installed.
        Set to [ ] to collect everything, which is upstream's default.
      '';
    };

    extraArgs = lib.mkOption {
      type = lib.types.listOf lib.types.str;
      default = [ ];
      example = [ "--no-task=deploy" ];
      description = "Additional arguments appended to the glpi-agent command line.";
    };

    interval = lib.mkOption {
      type = lib.types.str;
      default = "daily";
      description = ''
        systemd OnCalendar expression for how often to send inventory.
        Hardware and software lists change slowly; daily is plenty.
      '';
    };
  };

  config = lib.mkIf cfg.enable {
    # Runs as ROOT, deliberately. An inventory agent reads DMI/SMBIOS tables,
    # block device serials and the installed-package database; as an
    # unprivileged user it starts, succeeds, and reports a near-empty machine.
    systemd.services.glpi-agent = {
      description = "GLPI inventory agent";
      after = [ "network-online.target" ];
      wants = [ "network-online.target" ];

      # The agent shells out to tools it finds on PATH to fill in the parts of
      # the inventory it cannot read itself. Without these the run still
      # succeeds and the asset simply arrives with fields missing, which is
      # far harder to notice than a failure.
      path = with pkgs; [
        dmidecode
        pciutils
        usbutils
        iproute2
        util-linux
      ];

      serviceConfig = {
        Type = "oneshot";
        # --conf-file is what stops the /etc/agent.cfg death above; every
        # setting lives in that file, so this line stays short and the
        # effective configuration is one `cat` away.
        ExecStart = lib.concatStringsSep " " (
          [
            "${cfg.package}/bin/glpi-agent"
            "--conf-file=${configFile}"
          ]
          ++ cfg.extraArgs
        );
      };
    };

    systemd.timers.glpi-agent = {
      wantedBy = [ "timers.target" ];
      timerConfig = {
        OnCalendar = cfg.interval;
        # A laptop is suspended at most fixed times of day, so without this
        # the inventory is sent on whichever days the machine happens to be
        # awake at the right moment - and never on the others.
        Persistent = true;
        RandomizedDelaySec = "5m";
      };
    };
  };
}
